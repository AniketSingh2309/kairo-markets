# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM ---------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# groq = real Agno agents on Groq | stub = offline rule-based agents (tests / CI)
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_BASE_SECONDS=2
LLM_MAX_TOKENS=1500
# Only for reasoning models such as openai/gpt-oss-120b (low|medium|high); leave empty for Llama
LLM_REASONING_EFFORT=

# --- Data --------------------------------------------------------------
# mock = bundled fictional dataset | yahoo = real market data (Yahoo Finance, no key)
DATA_PROVIDER=mock
# deterministic = code plans tool calls | llm = Agno tool-calling agent plans them
DATA_AGENT_MODE=deterministic
# MOCK_DATA_PATH=tools/data/mock_market_data.json
# ALPHA_VANTAGE_API_KEY=

# --- Tool-call reliability ---------------------------------------------
TOOL_TIMEOUT_SECONDS=2
TOOL_MAX_RETRIES=2
TOOL_BACKOFF_BASE_SECONDS=0.25
MAX_TOOL_CALLS_PER_REQUEST=8

# --- Freshness / consistency policy ------------------------------------
STALE_AFTER_HOURS=96
MAX_SKEW_HOURS=24
PRICE_DISAGREEMENT_PCT=0.5

# --- Real trading (optional) -------------------------------------------
# Paper trading works without these. To place real orders, create a free app at
# https://account.upstox.com/developer/apps with this redirect URL, then paste its key and secret.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/broker/upstox/callback
